# Copy to .env for local dev, or set as a build-time environment variable
# on your hosting provider (Vercel/Netlify) for production.
# Must be set at build time - Create React App inlines it into the bundle.
REACT_APP_API_URL=http://localhost:5000

# Optional. Must match the backend API_KEY when that is set. Leave empty for
# open local demo. For Live View / snapshots the key is also appended as
# ?api_key= because <img> tags cannot send custom headers.
REACT_APP_API_KEY=
